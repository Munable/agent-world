[Unit]
Description=Agent World Commons
After=network.target

[Service]
Type=simple
User=agent-world
Group=agent-world
WorkingDirectory=/opt/agent-world
EnvironmentFile=/etc/agent-world/commons.env
Environment=PYTHONUNBUFFERED=1
Environment=FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/agent-world/.venv/bin/agent-world --world commons --universe commons --db /var/lib/agent-world/commons.sqlite3 --host 127.0.0.1 --port 8000 --public-url ${WORLD_PUBLIC_URL}
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StateDirectory=agent-world
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
